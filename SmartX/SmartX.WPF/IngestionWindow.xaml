<Window x:Class="SmartX.WPF.IngestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensor Ingestion" Height="700" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="&lt; Back" Click="Back_Click" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>

        
        <GroupBox Grid.Row="1" Header="Registered Sensors" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <ListView x:Name="SensorListView" Height="150">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="MAC Address" DisplayMemberBinding="{Binding MacAddress}" Width="150"/>
                            <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="150"/>
                            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="100"/>
                            <GridViewColumn Header="Current Value" DisplayMemberBinding="{Binding CurrentValue}" Width="100"/>
                            <GridViewColumn Header="Last Updated" DisplayMemberBinding="{Binding LastUpdated}" Width="90"/>
                            <GridViewColumn Header="Live" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="14" Height="14" Fill="{Binding PulseColor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Button x:Name="ToggleCreateButton" Content="Create New Sensor" Click="ToggleCreate_Click" Width="150" Margin="0,10,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </GroupBox>

        
        <GroupBox Grid.Row="2" Header="New Sensor" x:Name="CreatePanel" Visibility="Collapsed" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock Text="MAC Address:"/>
                <TextBox x:Name="MacBox" Margin="0,0,0,5"/>
                <TextBlock Text="Location (Room/Zone/Node):"/>
                <TextBox x:Name="LocationBox" Margin="0,0,0,5"/>
                <TextBlock Text="Category:"/>
                <ComboBox x:Name="CategoryBox" Margin="0,0,0,10">
                    <ComboBoxItem Content="Environmental"/>
                    <ComboBoxItem Content="Power"/>
                    <ComboBoxItem Content="Actuator"/>
                </ComboBox>

                <TextBlock Text="Attach File (optional):"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Choose File" Click="ChooseFile_Click" Width="100" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ChosenFileText" Text="No file selected" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save Sensor" Click="SaveSensor_Click" Width="120" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Click="CancelCreate_Click" Width="80"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        
        <GroupBox Grid.Row="3" Header="Other Actions" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button Content="Test Overload" Click="TestOverload_Click" Width="110" Margin="5"/>
                <Button Content="Validate Tree" Click="ValidateTree_Click" Width="110" Margin="5"/>
                <TextBlock x:Name="StatusText" Foreground="DarkGreen" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </GroupBox>

        
        <GroupBox Grid.Row="4" Header="Alerts (value outside safe range)">
            <ListBox x:Name="AlertsList" Margin="5" Foreground="DarkRed"/>
        </GroupBox>
    </Grid>
</Window>