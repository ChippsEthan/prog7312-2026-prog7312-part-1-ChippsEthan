<UserControl x:Class="SmartX.WPF.Views.CommandStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Real-Time Command Stream and History" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>

        
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="ResultCountText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Search (name, MAC, location, category or status)" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="SearchBox" Width="300" Padding="4" TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Category" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox x:Name="CategoryFilter" Width="150" Padding="4" SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All categories"/>
                            <ComboBoxItem Content="Environmental"/>
                            <ComboBoxItem Content="Power"/>
                            <ComboBoxItem Content="Actuator"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="AlertsOnly" Content="Active alerts only" VerticalAlignment="Bottom" Margin="0,0,0,6"
                              Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <Button Content="Clear" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Margin="16,0,0,0"
                            Click="ClearFilters_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

       
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

           
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="250"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Live devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListView x:Name="DeviceList" SelectionMode="Single" SelectionChanged="DeviceList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="135"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="160"/>
                                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="90"/>
                                    <GridViewColumn Header="Value" DisplayMemberBinding="{Binding CurrentValue}" Width="75"/>
                                    <GridViewColumn Header="Status" Width="85">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Updated" DisplayMemberBinding="{Binding LastUpdated}" Width="70"/>
                                    <GridViewColumn Header="Live" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="12" Height="12" Fill="{Binding PulseColor}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock x:Name="ChartTitle" DockPanel.Dock="Top" Text="Timeline: select a device"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
                    </DockPanel>
                </Border>
            </Grid>

            
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Manual override" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <UniformGrid Columns="3">
                                <Button x:Name="OnButton" Content="Turn ON" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="TurnOn_Click"/>
                                <Button x:Name="OffButton" Content="Turn OFF" Style="{StaticResource DangerButton}" Margin="3,0,3,0" Click="TurnOff_Click"/>
                                <Button x:Name="ToggleBtn" Content="Toggle" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="Toggle_Click"/>
                            </UniformGrid>
                            <Button Content="Shut down ALL actuators" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Click="AllOff_Click"/>
                            <Separator Margin="0,12"/>
                            <Button x:Name="UndoButton" Content="Undo last command" Style="{StaticResource GhostButton}" Click="Undo_Click"/>
                            <TextBlock x:Name="UndoInfo" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CommandStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Suggested actions" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LearnedText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="NoSuggestionsText" Text="No suggestions right now. They appear when an alert fires or you act on a device."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="SuggestionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding SeverityBrush}" BorderThickness="3,0,0,0" Background="#F9FAFB"
                                                CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Tag="{Binding}"
                                                        Click="Suggestion_Click" Style="{StaticResource PrimaryButton}"
                                                        Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ConfidenceText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Automated insights" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Problem devices flagged before you search for them" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="NoInsightsText" Text="All devices look healthy." Foreground="{StaticResource OkBrush}"/>
                            <ItemsControl x:Name="InsightsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding SeverityBrush}" BorderThickness="3,0,0,0" Background="#F9FAFB"
                                                CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Inspect" Tag="{Binding}"
                                                        Click="Insight_Click" Style="{StaticResource GhostButton}"
                                                        Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Ingestion queues" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="QueueText" FontFamily="Consolas" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock Text="Recently processed (newest first)" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <ListBox x:Name="ProcessedList" Height="150" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Test tools (these act like a device)" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Select a sensor first. Every action goes through the real API."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="Simulate critical alert" Style="{StaticResource DangerButton}" Click="SimulateCritical_Click" Margin="0,0,8,8"/>
                                <Button Content="Start gradual decline" Style="{StaticResource GhostButton}" Click="Drift_Click" Margin="0,0,8,8"/>
                                <Button x:Name="SilenceBtn" Content="Silence node" Style="{StaticResource GhostButton}" Click="Silence_Click" Margin="0,0,8,8"/>
                                <Button x:Name="QueueDemoBtn" Content="Queue priority demo" Style="{StaticResource GhostButton}" Click="QueueDemo_Click" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <CheckBox x:Name="RandomAnomaliesBox" Content="Random anomalies in the simulator" Click="RandomAnomalies_Click"/>
                            <TextBlock x:Name="ToolStatus" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Command history" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ListBox x:Name="HistoryList" Height="150" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>