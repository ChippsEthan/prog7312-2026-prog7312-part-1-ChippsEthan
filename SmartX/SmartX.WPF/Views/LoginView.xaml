<UserControl x:Class="SmartX.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#111827">
        <Border Style="{StaticResource Card}" Width="400" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Smart-X" FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="IoT Mesh Gateway. Please sign in." Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="Email"/>
                <TextBox x:Name="EmailBox" Padding="6" Margin="0,2,0,12"/>

                <TextBlock Text="Password"/>
                <PasswordBox x:Name="PasswordBox" Padding="6" Margin="0,2,0,6"/>

                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,8,0,4" Visibility="Collapsed"/>

                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Padding="14,10" Margin="0,10,0,8" Click="SignIn_Click"/>
                <Button x:Name="RegisterButton" Content="Create account" Style="{StaticResource GhostButton}"
                        Padding="14,10" Margin="0,0,0,8" Click="Register_Click"/>
                <Button x:Name="ForgotButton" Content="Forgot password?" Style="{StaticResource GhostButton}"
                        Padding="14,6" Click="Forgot_Click"/>

                <TextBlock Text="Secured with Firebase Authentication" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>