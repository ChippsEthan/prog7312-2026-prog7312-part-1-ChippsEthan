<UserControl x:Class="SmartX.WPF.Views.TopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="260"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Network Topology and Mesh Routing" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock x:Name="SummaryText" Text="Waiting for the API..." Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Mesh map -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Canvas x:Name="MeshCanvas" ClipToBounds="True" Background="Transparent"
                            SizeChanged="MeshCanvas_SizeChanged"/>
                    <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,4"
                               FontSize="11" IsHitTestVisible="False">
                        <Run Foreground="#16A34A" FontWeight="Bold" Text="Green = spanning-tree route"/>
                        <Run Foreground="#6B7280" Text="    Grey = spare link"/>
                        <Run Foreground="#DC2626" Text="    Red dashed = link to a down node"/>
                        <Run Foreground="#F59E0B" FontWeight="Bold" Text="    Amber = tracked path"/>
                    </TextBlock>
                </Grid>
            </Border>

           
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Track a node" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Type a MAC address or name, or click a node on the map."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6"
                                       TextWrapping="Wrap"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Track" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="Track_Click"/>
                                <TextBox x:Name="TrackBox" Padding="5" KeyDown="TrackBox_KeyDown"/>
                            </DockPanel>
                            <TextBlock x:Name="RouteText" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                                       Text="No node selected."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Failure simulation" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock x:Name="SelectedText" Text="Selected: none" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button x:Name="FailButton" Content="Fail node" Style="{StaticResource DangerButton}"
                                        Margin="0,0,4,0" Click="Fail_Click" IsEnabled="False"/>
                                <Button x:Name="RestoreButton" Content="Restore node" Style="{StaticResource GhostButton}"
                                        Margin="4,0,0,0" Click="Restore_Click" IsEnabled="False"/>
                            </UniformGrid>
                            <TextBlock x:Name="ActionText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Traversal (BFS / DFS)" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Starts at the selected node, or the gateway if none is selected."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6"
                                       TextWrapping="Wrap"/>
                            <UniformGrid Columns="2">
                                <Button Content="Run BFS" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"
                                        Click="Bfs_Click"/>
                                <Button Content="Run DFS" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0"
                                        Click="Dfs_Click"/>
                            </UniformGrid>
                            <TextBlock x:Name="TraversalText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Self-healing log" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                            <ListBox x:Name="RerouteList" MaxHeight="160" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="HistoryTitle" Text="Telemetry history: select a sensor" FontWeight="SemiBold"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="From (HH:mm)" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0"/>
                    <TextBox x:Name="FromBox" Width="60" Padding="3" Margin="0,0,10,0"/>
                    <TextBlock Text="To (HH:mm)" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0"/>
                    <TextBox x:Name="ToBox" Width="60" Padding="3" Margin="0,0,10,0"/>
                    <Button Content="Load range" Style="{StaticResource PrimaryButton}" Padding="12,4"
                            Margin="0,0,6,0" Click="LoadRange_Click"/>
                    <Button Content="Last 5 min" Style="{StaticResource GhostButton}" Padding="12,4"
                            Margin="0,0,6,0" Click="Last5_Click"/>
                    <Button Content="Last hour" Style="{StaticResource GhostButton}" Padding="12,4"
                            Click="LastHour_Click"/>
                </StackPanel>
                <TextBlock x:Name="HistoryInfo" DockPanel.Dock="Top" FontSize="12"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"
                           Text="Click a sensor on the map, then load a time range."/>
                <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="White" RowHeaderWidth="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="130"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150"/>
                        <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>